from aiogram import types, Dispatcher
from keyboards.default import settings_keyboard
from utils.language import get_text

async def settings_handler(message: types.Message):
    lang = message.from_user.language_code or "en"
    text = get_text(lang, "settings")
    await message.answer(text, reply_markup=settings_keyboard(lang))

def register_settings(dp: Dispatcher):
    dp.register_message_handler(settings_handler, commands=["settings"])
