from aiogram import types
from aiogram.dispatcher import Dispatcher
from utils.language import get_text
from keyboards.default import get_main_menu

HELP_TEXT = {
    "en": "🆘 <b>Help</b>\n\nSend me a video or music link — I’ll download it for you.\nUse /settings to change language or quality.",
    "ru": "🆘 <b>Помощь</b>\n\nОтправь мне ссылку на видео или музыку — я скачаю её для тебя.\nИспользуй /settings для изменения языка и качества.",
    "uz": "🆘 <b>Yordam</b>\n\nMenga video yoki musiqa havolasini yuboring — men uni yuklab beraman.\nTil va sifat sozlamalari uchun /settings buyrug'idan foydalaning."
    # Добавь остальные языки по необходимости
}

async def help_handler(message: types.Message):
    lang = await get_text(message.from_user.id)
    text = HELP_TEXT.get(lang, HELP_TEXT["en"])
    await message.answer(text, reply_markup=get_main_menu())

def register_help(dp: Dispatcher):
    dp.register_message_handler(help_handler, commands=["help"], state="*")
