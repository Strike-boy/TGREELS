from aiogram import types
from aiogram.dispatcher import Dispatcher
from utils.downloader import process_url
from utils.language import get_text
from keyboards.default import get_main_menu
from utils.logger import log_download

async def download_handler(message: types.Message):
    url = message.text.strip()

    if not url.startswith(("http://", "https://")):
        return await message.answer("❗ Пожалуйста, отправьте ссылку.")

    user_lang = await get_text(message.from_user.id)
    msg = await message.answer(get_text("downloading", user_lang))

    try:
        result = await process_url(url)
        if result["type"] == "video":
            await message.answer_video(
                result["file"],
                caption=result["caption"]
            )
        elif result["type"] == "audio":
            await message.answer_audio(
                result["file"],
                caption=result["caption"]
            )
        else:
            await message.answer("⚠️ Не удалось определить тип контента.")
        log_download(message.from_user.id, result["type"])
    except Exception as e:
        await message.answer(get_text("error", user_lang))

    await msg.delete()

def register_download(dp: Dispatcher):
    dp.register_message_handler(download_handler, content_types=types.ContentType.TEXT, state="*")
