from aiogram import types, Dispatcher
from aiogram.types import InlineKeyboardMarkup, InlineKeyboardButton
from services.downloader import get_video_formats, download_video_by_format
import os

# Храним состояния запросов
pending_downloads = {}

async def handle_download(message: types.Message):
    url = message.text.strip()
    formats = get_video_formats(url)

    if not formats:
        await message.answer("❌ Не удалось получить форматы видео.")
        return

    keyboard = InlineKeyboardMarkup(row_width=2)
    for f in formats[:6]:  # максимум 6 кнопок
        label = f"{f['resolution']} ({f['ext']})"
        button = InlineKeyboardButton(
            text=label,
            callback_data=f"dl|{f['format_id']}|{url}"
        )
        keyboard.add(button)

    await message.answer("📥 Выберите качество:", reply_markup=keyboard)

async def handle_download_callback(call: types.CallbackQuery):
    _, format_id, url = call.data.split("|")

    await call.message.edit_text("⏳ Загружаю видео...")

    video_path = download_video_by_format(url, format_id)
    if video_path:
        with open(video_path, 'rb') as video:
            await call.message.answer_video(video, caption="✅ Готово!")
        os.remove(video_path)
    else:
        await call.message.answer("❌ Ошибка при загрузке видео.")

def register_download_handlers(dp: Dispatcher):
    dp.register_message_handler(handle_download, content_types=types.ContentType.TEXT)
    dp.register_callback_query_handler(handle_download_callback, lambda c: c.data.startswith("dl|"))
