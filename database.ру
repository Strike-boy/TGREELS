user_stats = {}  # словарь: user_id -> количество загрузок

def increment_user(user_id):
    if user_id not in user_stats:
        user_stats[user_id] = 1
    else:
        user_stats[user_id] += 1

def get_top_users(limit=3):
    return sorted(user_stats.items(), key=lambda x: x[1], reverse=True)[:limit]
